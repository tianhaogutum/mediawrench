# Authored test configuration: use ExifTool's documented custom-namespace API
# to produce/read darktable's actual sequence-shaped color label property.
%Image::ExifTool::UserDefined = (
    'Image::ExifTool::XMP::Main' => {
        darktable => {
            SubDirectory => {
                TagTable => 'Image::ExifTool::UserDefined::darktable',
            },
        },
    },
);
%Image::ExifTool::UserDefined::darktable = (
    GROUPS => { 0 => 'XMP', 1 => 'XMP-darktable', 2 => 'Image' },
    NAMESPACE => { darktable => 'http://darktable.sf.net/' },
    WRITABLE => 'string',
    colorlabels => { Name => 'ColorLabels', Writable => 'integer', List => 'Seq' },
);
1;
